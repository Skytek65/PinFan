scope itemtype=\"https://schema.org/WebPage\" itemprop=\"item\"><span itemprop=\"name\">Pinball database</span></a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<meta itemprop=\"position\" content=\"1\" />\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t</ol>\n\t\t\t\t\t\n\t\t\t\t\t<a href=\"#scrollbottom\" onclick=\"return scrollToBottom();\" class=\"scrolltobottombutton\" title=\"Scroll to bottom\"><span class=\"icon icon-level-down\"></span></a>\n\n\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\n\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\t\t\n\t\t</div>\n\t\t\n\t\t</div> \n\t\t\n\t\t<div class=\"pagebody\">\n\t\t\t\n\n\n\t\n\t\n\t\n\t\n\t\t\n\t\n\n\t\n\t\n\t\t\t\t\t\n\t\n\t\t\n\t<a name=\"content\" id=\"content\"></a>\n\t\n\t\r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\n\t\r\nfunction toggleAllCheckboxes(elem, checkboxesClass) {\r\n\t\r\n\tvar inputs = $$('.' + checkboxesClass + ' input');\r\n\tif (!inputs) return false;\r\n\t\r\n\tvar checked = !elem.get('checked');\r\n\tinputs.set('checked', checked);\r\n\r\n\treturn true;\r\n}\r\n\r\nfunction toggleAdvancedSearch() {\r\n\tvar searchHost = $('advanced_search');\r\n\t\r\n\tif (searchHost.hasClass('notmobile')) searchHost.addClass('hidden').removeClass('notmobile');\r\n\t\r\n\tnew Fx.Reveal(searchHost).toggle();\r\n\t\r\n\treturn false;\r\n}\r\n\r\nwindow.addEvent('domready', function() {\r\n\r\n\tvar allManufToggle = document.getElement('.searchgroup-manufacturer input.all-toggle');\r\n\t$$('.manufacturer-checkboxes input').addEvent('click', function() {\r\n\t\tallManufToggle.set('checked', ($$('.manufacturer-checkboxes input').length == $$('.manufacturer-checkboxes input:checked').length));\r\n\t});\r\n});\r\n\r\nfunction findMachines(oForm, storeSearchInClouds) {\r\n//return true;\r\n\r\n\t\r\n\tvar targetDiv = $('find_list_elem');\r\n\tnew Element('br').addClass('breaker').injectInside(targetDiv);\r\n\ttargetDiv.setStyle('height', targetDiv.offsetHeight);\r\n\ttargetDiv.set('html', '');\r\n\t\r\n\tif (oForm['query']) document.getElements('#query').set('value', oForm['query'].value);\r\n\t\t\r\n\tvar submitButton = oForm.getElement('button[type=submit]');\r\n\tsetButtonWaitState(submitButton, true);\r\n\t\r\n\tnew Request.JSON({\r\n\t\t'url': '/api/pinsidesearch/listMachines',\r\n\t\t'onSuccess': function(oData) {\r\n\t\t\tsetButtonWaitState(submitButton, false);\r\n\t\t\ttargetDiv.set('html', '').setStyle('background', '');\r\n\t\t\tfinishFindMachines('find', oData, oForm);\r\n\t\t},\r\n\t\t'onFailure': function(oXHR) {\r\n\t\t\tsetButtonWaitState(submitButton, false);\r\n\t\t\ttargetDiv.set('html', '').setStyle('background', '');\r\n\t\t\tdefaultFailureFunction(oXHR);\r\n\t\t}\r\n\t}).get(oForm);\r\n\t\r\n\treturn false;\r\n}\r\n\r\nfunction simulateSearchEntry(linkElem) {\r\n\t\r\n\tvar oForm = $('machineSearchForm');\r\n\tif (oForm) {\r\n\t\tresetSearchForm();\r\n\t\toForm['query'].value = linkElem.rel;\r\n\t\t//findMachines(oForm);\r\n\t\toForm.submit();\r\n\t\t\r\n\t\treturn false;\r\n\t} else return true;\r\n\t\r\n}\r\n\r\nfunction finishFindMachines(status, oData, oForm) {\r\n\t\r\n\tvar listElem\t\t= $('find_list_elem');\r\n\t\r\n\tvar descriptionElem\t= new Element('div').addClass('content heading-blue bordered').injectInside(listElem);\r\n\tvar descriptionHead = new Element('h2').addClass('fat-box-title').injectInside(descriptionElem);\r\n\tvar descriptionText = new Element('p').injectInside(descriptionElem);\r\n\t\r\n\tvar descText = 'Found ' + oData.machine_count + ' machine' + (oData.machine_count>1 ? 's' : '');\r\n\t\r\n\tif (descriptionHead) \tdescriptionHead.set('html', descText);\r\n\tif (descriptionText) \tdescriptionText.set('html', oData.results_text);\r\n\t\r\n\tif (listElem) \t\t\tnew Element('ul').addClass('machine-list').set('html', oData.machine_list_markup).injectInside(listElem);\r\n\t\r\n\tlistElem.setStyle('height', 'auto');\r\n\t\r\n\tnew Fx.Scroll(window).toElement(listElem);\r\n\t\r\n\r\n}\r\n\r\nfunction renderFindList(hostElem, markup) {\r\n\t\r\n}\r\n\r\nfunction attachMouseEvents(liElem) {\r\n\tliElem.addEvent('mouseover', function() {this.addClass('hover');});\r\n\tliElem.addEvent('mouseout', function() {this.removeClass('hover');});\r\n}\r\n\r\nfunction resetSearchForm(e) {\r\n\tlocation.href = '?';\r\n\t// if (e) new Event(e).stop();\r\n\t\r\n\t// $('machineSearchForm').getElements('select').each(function(obj) {\r\n\t// \tobj.selectedIndex = 0;\r\n\t// });\r\n\t\r\n\t// $('query').value = '';\r\n\t\t\r\n\treturn false;\r\n\r\n}\r\n\r\n//]]>\r\n</script>\r\n\r\n\r\n\r\n<div class=\"centered transp-bg-white\">\n\n\t<div class=\"dotted-t\"></div>\n\t\n\t<div class=\"width-four heading-black bordered\">\n\t\t\n\t\t\t\t\n\t\t<div class=\"content \">\n\t\t\t<h1 class=\"fat-box-title\">The Pinside Pinball Machine Database</h1>\n\t\t\t\n\t\t\t\t\t\t<p class=\"bigger\">The Pinside database currently holds 3,190 games, ranging from the early 1930's up to today. <span class=\"notmobile\">Each game has its own archive page, to which Pinsiders can add game details, photos, reviews and much more!</span> </p>\t\t\t\t\t\t\n\t\t</div>\n\t\t\n\t</div>\n\t\n\t<div class=\"width-two heading-black bordered notmobile\">\n\t\t<a href=\"/pinball/machine/willy-wonka-and-the-chocolate-factory-standard\"><img src=\"https://images.pinside.com/e/26/e26131aa98da421bd11f7ef47c5e244735bda6c5/polaroid/57696c6c7920576f6e6b612026205468652043686f636f6c61746520466163746f727920285374616e646172642920283230313929/9a0a89fb0780987e455fec7e262ba30d/512/e26131aa98da421bd11f7ef47c5e244735bda6c5.png\" alt=\"\" class=\"polaroid-big\" style=\"width:240px; margin-top:-82px;\" /></a>\t</div>\n\t\n\t\n\t<br class=\"breaker\" />\n\t\n</div>\n\r\n\r\n\r\n\r\n\r\n<div class=\"centered transp-bg-white\">\r\n\r\n\t<div class=\"width-four heading-blue \">\r\n\t\t\r\n\t\t<div class=\"dotted-t\"></div>\r\n\t\t\r\n\t\t<div class=\"content bordered\">\r\n\t\t\t\r\n\t\t\t<h2 class=\"fat-box-title\">Quick search</h2>\r\n\t\t\t\t\r\n\t\t\t<p class=\"bigger\">\r\n\t\t\t\t\t\t\t\tEnter (part of) a machine name\r\n\t\t\t\t<span class=\"notmobile\">(e.g. '<a href=\"/pinball/machine/?query=shaker\" rel=\"shaker\" onclick=\"return simulateSearchEntry(this)\">shaker</a>'), \r\n\t\t\t\tan abbreviation (e.g. '<a href=\"/pinball/machine/?query=tz\" rel=\"tz\" onclick=\"return simulateSearchEntry(this)\">tz</a>')\r\n\t\t\t\t</span>\r\n\t\t\t</p>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\r\n\t\t\r\n\t\t\t\r\n\t\t\t<form id=\"machineSearchForm\" name=\"machineSearchForm\" method=\"get\" action=\"/pinball/machine\" class=\"editForm\">\r\n\t\t\t\t<input type=\"hidden\" name=\"token\" value=\"\">\r\n\r\n\t\t\t\t<label>Machine name / abbreviation</label>\t\t\t\r\n\r\n\t\t\t\t<div class=\"display-flex\">\r\n\t\t\t\t\r\n\t\t\t\t\t<input type=\"text\" style=\"width:60%; flex-grow:1; margin-right:15px;\" class=\"texthuge\" id=\"query\" name=\"query\" value=\"Beetle\" />\r\n\t\t\t\t\r\n\t\t\t\t\t<button type=\"submit\" class=\"welldefinedbutton\">\r\n\t\t\t\t\t\t<span class=\"icon icon-search\"></span>\r\n\t\t\t\t\t\tFind games\r\n\t\t\t\t\t</button>\r\n\r\n\t\t\t\t</div>\r\n\t\t\t\t\r\n\t\t\t\t<div class=\"mobileonly\">\r\n\t\t\t\t\t<br />\r\n\t\t\t\t\t<button type=\"button\" class=\"welldefinedbutton welldefinedbutton-secondary welldefinedbutton-small\" onclick=\"return toggleAdvancedSearch(this);\">\r\n\t\t\t\t\t\t<span class=\"icon icon-right-1\"></span> Open advanced search\r\n\t\t\t\t\t</button>\r\n\t\t\t\t</div>\r\n\t\t\t\t\r\n\t\t\t</form>\r\n\t\t\t\t\r\n\r\n\t\t</div>\r\n\t\t\r\n\t</div>\r\n\t\r\n\t<div class=\"notmobile\">\r\n\r\n\t\t<div class=\"width-two heading-blue\">\r\n\t\t\t\r\n\t\t\t<div class=\"dotted-t\"></div>\r\n\t\t\t\r\n\t\t\t<div class=\"content bordered\">\r\n\t\t\t\t<a href=\"/pinball/machine/random\"><img src=\"/img/teaserboxes/questionmark.png\" alt=\"Random machine\" style=\"width:80px; float:left; margin:-19px 0 20px 0;\" /></a>\r\n\t\t\t\t<h2 class=\"fat-box-title\"><a href=\"/pinball/machine/random\">Random!</a></h2>\r\n\t\t\t\t<p>Click the question mark and be surprised by a random archive pick!</p>\r\n\t\t\t</div>\r\n\t\t\t\r\n\r\n\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\t\t<br class=\"breaker\" />\r\n\t\t\r\n\t</div>\r\n\t\r\n\t<br class=\"breaker\" />\r\n\t\r\n</div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<a name=\"search\" id=\"search\"></a>\r\n<a name=\"results\" id=\"results\"></a>\r\n\r\n<div class=\"spacer-half\"></div>\r\n\r\n<div class=\"centered transp-bg-white\">\r\n\t\r\n\r\n\t<div class=\"dotted-t\"></div>\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t<div id=\"advanced_search\" class=\"width-oneandhalf heading-blue bordered notmobile\">\r\n\t\t\r\n\t\t<form id=\"machineSearchForm\" name=\"machineSearchForm\" method=\"get\" action=\"/pinball/machine#results\" class=\"editForm\">\r\n\t\t<input type=\"hidden\" name=\"token\" value=\"\">\r\n\t\t\r\n\t\t\r\n\t\t<div class=\"content sidesearchbar\">\r\n\t\t\t\r\n\t\t\t<h2 class=\"fat-box-title\">Game Search</h2>\r\n\t\t\t\t\t\t<fieldset class=\"searchgroup searchgroup-active\">\r\n\t\t\t\t<legend id=\"keywordslegend\">Keyword search</legend>\t\t\r\n\t\t\t\t\r\n\t\t\t\t<div id=\"keywordsearchbox\">\r\n\t\t\t\t\t<input type=\"text\" class=\"texthuge\" id=\"query\" name=\"query\" value=\"Beetle\" placeholder=\"Keyword(s)\" style=\"font-size:18px;\" />\r\n\t\t\t\t</div>\r\n\t\t\t\t\r\n\t\t\t</fieldset>\r\n\t\t\t\r\n\r\n\t\t\t\t\t\t<fieldset class=\"searchgroup\">\r\n\t\t\t\t<legend id=\"keywordslegend\">Tag search</legend>\t\t\r\n\t\t\t\t\r\n\t\t\t\t<div id=\"tagsearchbox\">\r\n\r\n\t\t\t\t\t<input type=\"hidden\" class=\"textbig\" name=\"tags\" id=\"tags\" placeholder=\"+ Find by tags\" value=\"\">\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t<script type=\"text/javascript\">\r\n\t\t\t\t\tvar tagify = null;\r\n\r\n\t\t\t\t\twindow.addEvent('domready', function() {\r\n\t\t\t\t\t\tvar tagifyStyles = Asset.css('https://cdn.jsdelivr.net/npm/@yaireo/tagify@2.7.7/dist/tagify.css');\r\n\t\t\t\t\t\tvar tagifyScript = Asset.javascript('https://cdn.jsdelivr.net/npm/@yaireo/tagify@2.7.7/dist/tagify.min.js', {\r\n\t\t\t\t\t\t\tid: 'tagifyScript',\r\n\t\t\t\t\t\t\tonLoad: setupTagify\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t});\r\n\r\n\t\t\t\t\tfunction setupTagify(){\r\n\t\t\t\t\t\tvar input = document.querySelector('input#tags');\r\n\t\t\t\t\t\ttagify = new Tagify(input, {\r\n\t\t\t\t\t\t\twhitelist:false,\r\n\t\t\t\t\t\t\tenforceWhitelist: false,\r\n\t\t\t\t\t\t\tautocomplete: false,\r\n\t\t\t\t\t\t\ttransformTag: function(value){return value.replace(' ', '-')},\r\n\t\t\t\t\t\t\tmaxTags: 3,\r\n\t\t\t\t\t\t\taddTagOnBlur: false,\r\n\t\t\t\t\t\t\tdropdown : {\r\n\t\t\t\t\t\t\t\tclassname : \"tagify__dropdown tagify-dropdown-big\",\r\n\t\t\t\t\t\t\t\tenabled   : 1,\r\n\t\t\t\t\t\t\t\tmaxItems  : 10\r\n\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t});\r\n\r\n\t\t\t\t\t\ttagify.on('input', fetchTagifyWhitelist);\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\tfunction fetchTagifyWhitelist(e) {\r\n\t\t\t\t\t\tif (window.tagsWhitelist || window.loadTagsWhitelist) return console.info('Whitelist already loading/loaded!');\r\n\r\n\t\t\t\t\t\tvar value = e ? e.detail : '';\r\n\t\t\t\t\t\ttagify.settings.whitelist.length = 0; // reset the whitelist\r\n\r\n\t\t\t\t\t\twindow.loadTagsWhitelist = new Request.JSON({\r\n\t\t\t\t\t\t\t'url': '/api/pinsideTags/getTags',\r\n\t\t\t\t\t\t\t'link': 'ignore',\r\n\t\t\t\t\t\t\t'data': {tag_linktype: 'machine', get_whitelist: true},\r\n\t\t\t\t\t\t\t'onSuccess': function(oData) {\t\t\t\t\r\n\t\t\t\t\t\t\t\twindow.loadTagsWhitelist = null;\r\n\t\t\t\t\t\t\t\twindow.tagsWhitelist = tagify.settings.whitelist = oData['tags_whitelist'];\r\n\t\t\t\t\t\t\t\t// tagify.dropdown.show.call(tagify, value); // render the suggestions dropdown\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t}.bind(this),\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t'onFailure': function(oHxr) {\r\n\t\t\t\t\t\t\t\twindow.loadTagsWhitelist = null;\r\n\t\t\t\t\t\t\t\tdefaultFailureFunction(oXhr);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t\